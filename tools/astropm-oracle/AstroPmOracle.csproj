<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Vergleichsorakel (AP-13a, specs/engine/allocation.md §11.2). Die Originalquellen liegen nach
    `pnpm oracle:run` (bzw. `tsx tools/astropm-oracle/src/fetch.ts`) gepatcht unter upstream/ und
    werden nicht eingecheckt. TargetInstructionSet.cs wird nur gelesen (Tie-Breaks), nicht übersetzt.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <AssemblyName>AstroPmOracle</AssemblyName>
    <RootNamespace>NinaPm.Oracle</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0219;CS8321</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="cs/*.cs" />
    <Compile Include="upstream/Models/ScheduleEngine.cs" />
    <Compile Include="upstream/Models/SessionScheduler.cs" />
    <Compile Include="upstream/Models/ProjectTarget.cs" />
    <Compile Include="upstream/Models/AstroCalculator.cs" />
    <Compile Include="upstream/Models/ExoTransit.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>
</Project>
