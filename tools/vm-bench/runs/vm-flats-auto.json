{
  "name": "vm-flats-auto",
  "description": "P-38 auf echtem NINA (≈ 20 min): Auto-Flats einmal je Projekt, beide Projekte haben schon Flats → alle Kombinationen covered, kein Flat-Lauf (Boxen laufen nicht), Session abgeschlossen.",
  "simRun": "vm-flats-auto",
  "scenario": "vm-flats-auto",
  "untilMin": 20,
  "sequence": {
    "from": "one-night-safety",
    "removeFromStart": ["WaitForSunAltitude", "RunAutofocus"],
    "flats": true
  },
  "profile": {
    "MeridianFlipSettings-MinutesAfterMeridian": 1,
    "MeridianFlipSettings-MaxMinutesAfterMeridian": 5,
    "MeridianFlipSettings-PauseTimeBeforeMeridian": 0,
    "MeridianFlipSettings-Recenter": false,
    "MeridianFlipSettings-AutoFocusAfterFlip": false,
    "SequenceSettings-DisableSimpleSequencer": true
  },
  "trainedFlats": {
    "timeS": 1,
    "binnings": [1, 2]
  },
  "connect": ["camera", "mount", "filterwheel", "guider", "safetymonitor"],
  "coolC": -10,
  "steps": [
    {
      "atMin": 12,
      "screenshot": "ohne-flat-lauf",
      "tab": "sequencer"
    }
  ]
}
