{
  "name": "vm-flats",
  "description": "P-12 + P-35 auf echtem NINA (≈ 25 min): Flats nach der Nacht (L/Ha Bin 1, L Bin 2 mit Gain/Offset null), 5 je Kombination, Trained Flat/Dark Flat Exposure; NINA-Neustart, sobald die 2. Kombination beginnt; Fortsetzen mit den fehlenden Aufnahmen.",
  "simRun": "vm-flats",
  "scenario": "vm-flats",
  "untilMin": 30,
  "sequence": {
    "from": "one-night-safety",
    "removeFromStart": ["WaitForSunAltitude", "RunAutofocus"],
    "flats": true
  },
  "profile": {
    "MeridianFlipSettings-MinutesAfterMeridian": 1,
    "MeridianFlipSettings-MaxMinutesAfterMeridian": 5,
    "MeridianFlipSettings-PauseTimeBeforeMeridian": 0,
    "MeridianFlipSettings-Recenter": false,
    "MeridianFlipSettings-AutoFocusAfterFlip": false,
    "SequenceSettings-DisableSimpleSequencer": true
  },
  "trainedFlats": {
    "timeS": 1,
    "binnings": [1, 2]
  },
  "connect": ["camera", "mount", "filterwheel", "guider", "safetymonitor"],
  "coolC": -10,
  "steps": [
    {
      "atMin": 13,
      "restartAfterLog": {
        "contains": "FLATS_START combination=",
        "nth": 2
      }
    },
    {
      "atMin": 20,
      "screenshot": "flats-nach-neustart",
      "tab": "sequencer"
    }
  ]
}
