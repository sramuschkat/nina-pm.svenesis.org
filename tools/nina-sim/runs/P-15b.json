{
  "protocol": "P-15b",
  "scenario": "replan-transit",
  "description": "Im laufenden Block wird ein Transit festgelegt (Fenster ab +15 min): Block endet transit_interrupt, neuer Plan mit Transitblock, Serie bis Fensterende.",
  "untilMin": 45,
  "setup": {},
  "steps": [
    {
      "atMin": 4,
      "server": "lock_transit"
    }
  ],
  "asserts": [
    [
      {
        "log": {
          "event": "BLOCK_END",
          "where": {
            "reason": "transit_interrupt"
          }
        },
        "min": 1,
        "max": 1
      }
    ],
    [
      {
        "order": [
          {
            "event": "BLOCK_END",
            "where": {
              "reason": "transit_interrupt"
            }
          },
          {
            "event": "PLAN",
            "where": {
              "reason": "refresh"
            }
          },
          {
            "event": "TRANSIT_START"
          }
        ]
      }
    ],
    [
      {
        "log": {
          "event": "TRANSIT_END"
        },
        "min": 1,
        "max": 1
      },
      {
        "report": "captures",
        "where": {
          "filterShortName": "R"
        },
        "min": 20
      },
      {
        "report": "rejected",
        "min": 0,
        "max": 0
      }
    ]
  ]
}
