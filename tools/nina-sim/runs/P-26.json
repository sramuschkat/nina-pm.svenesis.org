{
  "protocol": "P-26",
  "scenario": "mosaic-flip",
  "description": "2×1-Mosaik am Meridian: Flip im Block von Panel 1, kein zweiter Flip für Panel 2, kein Nachrotieren.",
  "untilMin": 45,
  "setup": {
    "rotatorConnected": true
  },
  "steps": [],
  "asserts": [
    [
      {
        "log": {
          "event": "BLOCK_START"
        },
        "min": 2
      }
    ],
    [
      {
        "log": {
          "event": "FLIP",
          "where": {
            "pierBefore": "west",
            "pierAfter": "east"
          }
        },
        "min": 1,
        "max": 1
      },
      {
        "report": "events",
        "where": {
          "kind": "flip"
        },
        "whereExists": ["durationS"],
        "min": 1,
        "max": 1
      }
    ],
    [
      {
        "order": [
          {
            "event": "FLIP"
          },
          {
            "event": "BLOCK_END"
          },
          {
            "event": "BLOCK_START"
          }
        ]
      },
      {
        "none": {
          "event": "FLIP"
        },
        "after": {
          "event": "BLOCK_START"
        },
        "nth": 2
      }
    ],
    [
      {
        "log": {
          "event": "ROTATION_MISMATCH"
        },
        "min": 0,
        "max": 0
      }
    ]
  ]
}
