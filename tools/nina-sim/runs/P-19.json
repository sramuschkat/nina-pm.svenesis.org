{
  "protocol": "P-19",
  "scenario": "filters-readout",
  "description": "Filter und Auslesemodus nicht im Profil: Zeile bzw. Belichtung übersprungen, nie mit anderem Filter/Modus; eine Kamera mit genau einem Modus belichtet.",
  "untilMin": 50,
  "setup": {
    "profileFilters": ["LUMINANCE", "RED", "GREEN", "BLUE", "HA 3nm", "SII"]
  },
  "steps": [
    {
      "atMin": 21,
      "sim": "readout_modes",
      "names": ["Only Mode"]
    }
  ],
  "asserts": [
    [
      {
        "log": {
          "event": "FILTER_NOT_FOUND",
          "where": {
            "short": "OIII"
          }
        },
        "min": 1,
        "max": 1
      },
      {
        "report": "captures",
        "where": {
          "filterShortName": "OIII"
        },
        "min": 0,
        "max": 0
      }
    ],
    [
      {
        "log": {
          "event": "FILTER_NOT_FOUND",
          "where": {
            "short": "Ha"
          }
        },
        "min": 1,
        "max": 1
      },
      {
        "report": "captures",
        "where": {
          "filterShortName": "Ha"
        },
        "min": 0,
        "max": 0
      }
    ],
    [
      {
        "log": {
          "event": "READOUT_MODE_NOT_FOUND",
          "where": {
            "name": "Ultra Mode"
          }
        },
        "min": 1,
        "max": 1
      },
      {
        "report": "captures",
        "where": {
          "filterShortName": "L"
        },
        "min": 0,
        "max": 0
      }
    ],
    [
      {
        "report": "captures",
        "where": {
          "filterShortName": "R",
          "readoutModeIndex": 0
        },
        "min": 1
      }
    ],
    [
      {
        "log": {
          "event": "FILTER_NOT_FOUND"
        },
        "min": 2,
        "max": 2
      },
      {
        "log": {
          "event": "READOUT_MODE_NOT_FOUND"
        },
        "min": 1,
        "max": 1
      }
    ]
  ]
}
