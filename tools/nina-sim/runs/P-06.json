{
  "protocol": "P-06",
  "scenario": "replan",
  "description": "Projekt 2 während Block 1 pausiert: Neuplanung vor Block 2 ohne Projekt 2; ohne Änderung kein neuer Plan.",
  "untilMin": 120,
  "setup": {},
  "steps": [
    {
      "atMin": 8,
      "server": "pause_project",
      "project": "ngc7000"
