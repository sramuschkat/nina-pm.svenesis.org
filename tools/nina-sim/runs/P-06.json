      }
    ],
    [
      {
        "log": {
          "event": "PLAN_REBUILT"
        },
        "min": 1
      },
      {
        "order": [
          {
            "event": "TARGETS"
          },
          {
            "event": "TARGETS"
          },
          {
            "event": "PLAN_REBUILT",
            "where": {
              "reason": "refresh"
            }
          },
          {
            "event": "BLOCK_START"
          }
        ]
      },
      {
        "report": "captures",
        "where": {
          "filterShortName": "Ha"
        },
        "max": 0,
        "min": 0
      }
    ],
    [
      {
        "none": {
          "event": "PLAN_REBUILT"
        },
        "before": {
          "event": "TARGETS"
        },
        "nth": 2
      },
      {
        "log": {
          "event": "BLOCK_END",
          "where": {
            "reason": "completed"
          }
        },
        "min": 1
      }
    ]
  ]
