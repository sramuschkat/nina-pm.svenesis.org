<ResourceDictionary
    x:Class="NinaPm.Nina.Ui.Dock.DockTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:NinaPm.Nina.Ui">
    <!--
        Fenster im Imaging-Reiter (AP-53b, FA-NIN-28, execution.md §10). NINA sucht die Vorlage eines andockbaren
        ViewModels unter "<voller Typname>_Dockable" (Muster nach dem Astro-PM-NINA-Plugin, MIT,
        Views/AstroPMImagingPanelTemplate.xaml @ 5dd621d). Bindungen nur über Namen (NinaPm.Nina.Ui kennt die ViewModels
        nicht). Farben aus NINAs Theme; nur die Plangrafik bleibt dunkel wie im Simulator.
    -->
    <BooleanToVisibilityConverter x:Key="NinaPm.Dock.BoolToVisibility" />

    <!--  Plangrafik (PlanChartView) wie im Simulator der Optionsseite: Himmel, Blöcke, Lücken, Filterleiste, Kurven, Beschriftung.  -->
    <DataTemplate x:Key="NinaPm.PlanChart">
        <Border HorizontalAlignment="Left" Background="{Binding FrameBrush}" CornerRadius="6">
            <Grid Width="{Binding ChartWidth}" Height="{Binding ChartHeight}" ClipToBounds="True">
                <Canvas IsHitTestVisible="False">
                    <Rectangle Canvas.Left="{Binding PlotLeft}" Canvas.Top="{Binding PlotTopPx}" Width="{Binding PlotWidthPx}"
                               Height="{Binding PlotHeightPx}" Fill="{Binding SkyBrush}" />
                </Canvas>
                <ItemsControl ItemsSource="{Binding Rects}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="{Binding Width}" Height="{Binding Height}" Background="{Binding Fill}" BorderBrush="{Binding Stroke}"
                                    BorderThickness="{Binding Border}" ToolTip="{Binding ToolTip}">
                                <TextBlock Margin="{Binding LabelMargin}" VerticalAlignment="{Binding LabelAlignment}" FontSize="{Binding LabelSize}"
                                           FontWeight="{Binding LabelWeight}" Foreground="{Binding LabelBrush}" Text="{Binding Label}"
                                           TextTrimming="CharacterEllipsis" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl IsHitTestVisible="False" ItemsSource="{Binding Polygons}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Polygon Fill="{Binding Fill}" Points="{Binding Points}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl IsHitTestVisible="False" ItemsSource="{Binding Lines}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Polyline Points="{Binding Points}" Stroke="{Binding Stroke}" StrokeDashArray="{Binding Dash}" StrokeThickness="{Binding Thickness}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <ItemsControl IsHitTestVisible="False" ItemsSource="{Binding Labels}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Canvas.Left" Value="{Binding Left}" />
                            <Setter Property="Canvas.Top" Value="{Binding Top}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="{Binding Padding}" Background="{Binding Background}">
                                <TextBlock FontSize="{Binding Size}" FontWeight="{Binding Weight}" Foreground="{Binding Foreground}" Text="{Binding Text}" />
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>
    </DataTemplate>

    <!--  Zelle der Statuszeile: kleine Beschriftung über dem Wert.  -->
    <Style x:Key="NinaPm.Dock.Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Opacity" Value="0.65" />
    </Style>

    <!--  Fenster „NINA-PM“: Status, Plangrafik, Fußzeile; schmal zusätzlich die Blockliste.  -->
    <DataTemplate x:Key="NinaPm.Nina.Dock.NightPanelVM_Dockable">
        <Grid Loaded="OnDockLoaded" SizeChanged="OnDockSizeChanged">
            <TextBlock Margin="12" Opacity="0.75" Text="{Binding Placeholder}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRuntime}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                          Visibility="{Binding HasRuntime, Converter={StaticResource NinaPm.Dock.BoolToVisibility}}">
                <StackPanel Margin="0,0,0,6">
                    <Border Padding="8,4" Background="#B3261E" Visibility="{Binding TestBanner, Converter={StaticResource NinaPm.Dock.BoolToVisibility}}">
                        <TextBlock FontWeight="SemiBold" Foreground="White" Text="{Binding TestBannerText}" />
                    </Border>

                    <!--  Statuszeile breit: Zellen nebeneinander, umbrechend.  -->
                    <Border Padding="10,8" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                            Visibility="{Binding IsWide, Converter={StaticResource NinaPm.Dock.BoolToVisibility}}">
                        <WrapPanel>
                            <Border Margin="0,2,16,2" Padding="8,3" VerticalAlignment="Center" Background="{DynamicResource ButtonBackgroundSelectedBrush}" CornerRadius="3">
                                <TextBlock FontWeight="Bold" Foreground="{DynamicResource ButtonForegroundBrush}" Text="{Binding StateText}" />
                            </Border>
                            <StackPanel Margin="0,2,16,2">
                                <TextBlock Style="{StaticResource NinaPm.Dock.Caption}" Text="{Binding TargetLabel}" />
                                <TextBlock FontSize="13" FontWeight="SemiBold" Text="{Binding TargetText}" />
                            </StackPanel>
                            <StackPanel Margin="0,2,16,2">
                                <TextBlock Style="{StaticResource NinaPm.Dock.Caption}" Text="{Binding FilterLabel}" />
                                <TextBlock FontWeight="SemiBold" Text="{Binding FilterText}" />
                            </StackPanel>
                            <StackPanel MinWidth="170" Margin="0,2,16,2">
                                <TextBlock Style="{StaticResource NinaPm.Dock.Caption}" Text="{Binding ExposureLabel}" />
                                <StackPanel Orientation="Horizontal" Visibility="{Binding HasProgress, Converter={StaticResource NinaPm.Dock.BoolToVisibility}}">
                                    <ProgressBar Width="110" Height="6" Margin="0,0,8,0" VerticalAlignment="Center" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />
                                    <TextBlock FontWeight="SemiBold" Text="{Binding RemainingText}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Margin="0,2,16,2">
                                <TextBlock Style="{StaticResource NinaPm.Dock.Caption}" Text="{Binding CameraLabel}" />
                                <TextBlock Text="{Binding CameraText}" />
                            </StackPanel>
                            <StackPanel Margin="0,2,16,2">
                                <TextBlock Style="{StaticResource NinaPm.Dock.Caption}" Text="{Binding NextLabel}" />
                                <TextBlock Text="{Binding NextText}" />
                            </StackPanel>
                            <StackPanel Margin="0,2,16,2">
                                <TextBlock Style="{StaticResource NinaPm.Dock.Caption}" Text="{Binding OutboxLabel}" />
                                <TextBlock Text="{Binding OutboxText}" />
                            </StackPanel>
                        </WrapPanel>
                    </Border>

                    <!--  Statuszeile schmal: Schlüssel-Wert-Liste.  -->
                    <Border Padding="10,8" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                            Visibility="{Binding IsNarrow, Converter={StaticResource NinaPm.Dock.BoolToVisibility}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="92" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Opacity="0.65" Text="{Binding StateLabel}" />
                            <Border Grid.Row="0" Grid.Column="1" Margin="0,0,0,3" Padding="6,1" HorizontalAlignment="Left"
                                    Background="{DynamicResource ButtonBackgroundSelectedBrush}" CornerRadius="3">
                                <TextBlock FontWeight="Bold" Foreground="{DynamicResource ButtonForegroundBrush}" Text="{Binding StateText}" />
                            </Border>
                            <TextBlock Grid.Row="1" Opacity="0.65" Text="{Binding TargetLabel}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,3" FontWeight="SemiBold" Text="{Binding TargetText}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="2" Opacity="0.65" Text="{Binding FilterLabel}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,3" Text="{Binding FilterText}" />
                            <TextBlock Grid.Row="3" Opacity="0.65" Text="{Binding ExposureLabel}" TextWrapping="Wrap" />
                            <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,0,0,3" Orientation="Horizontal"
                                        Visibility="{Binding HasProgress, Converter={StaticResource NinaPm.Dock.BoolToVisibility}}">
                                <ProgressBar Width="70" Height="6" Margin="0,0,8,0" VerticalAlignment="Center" Maximum="100" Value="{Binding ProgressPercent, Mode=OneWay}" />
                                <TextBlock Text="{Binding RemainingText}" />
                            </StackPanel>
                            <TextBlock Grid.Row="4" Opacity="0.65" Text="{Binding CameraLabel}" />
                            <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,0,0,3" Text="{Binding CameraText}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="5" Opacity="0.65" Text="{Binding NextLabel}" />
                            <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,0,0,3" Text="{Binding NextText}" TextWrapping="Wrap" />
                            <TextBlock Grid.Row="6" Opacity="0.65" Text="{Binding OutboxLabel}" />
                            <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding OutboxText}" />
                        </Grid>
                    </Border>

                    <Border Padding="10,4" Background="#3B1F1F" Visibility="{Binding IsBlocked, Converter={StaticResource NinaPm.Dock.BoolToVisibility}}">
                        <TextBlock Foreground="White" Text="{Binding BlockedText}" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Margin="12,8,12,4" FontSize="11" Opacity="0.7" Text="{Binding PlanHeader}" />
                    <ContentControl Margin="12,0,12,4" Content="{Binding Chart}" ContentTemplate="{StaticResource NinaPm.PlanChart}"
                                    Visibility="{Binding HasChart, Converter={StaticResource NinaPm.Dock.BoolToVisibility}}" />
                    <WrapPanel Margin="12,2,12,4">
                        <StackPanel Margin="0,0,14,0" Orientation="Horizontal">
                            <Border Width="12" Height="9" Margin="0,0,5,0" Background="#2480C8F8" BorderBrush="#667FC8F8" BorderThickness="1" />
                            <TextBlock FontSize="11" Opacity="0.75" Text="{Binding LegendPast}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0" Orientation="Horizontal">
                            <Border Width="12" Height="9" Margin="0,0,5,0" Background="#997FC8F8" BorderBrush="#E67FC8F8" BorderThickness="1" />
                            <TextBlock FontSize="11" Opacity="0.75" Text="{Binding LegendPlanned}" />
                        </StackPanel>
                        <StackPanel Margin="0,0,14,0" Orientation="Horizontal">
                            <Border Width="12" Height="9" Margin="0,0,5,0" Background="#8CE5484D" />
                            <TextBlock FontSize="11" Opacity="0.75" Text="{Binding LegendGap}" />
                        </StackPanel>
                    </WrapPanel>

                    <!--  Schmal: Blockliste „Heutige Ziele“.  -->
                    <StackPanel Margin="12,6,12,0" Visibility="{Binding IsNarrow, Converter={StaticResource NinaPm.Dock.BoolToVisibility}}">
                        <TextBlock Margin="0,0,0,4" FontSize="11" Opacity="0.7" Text="{Binding BlocksHeader}" />
                        <ItemsControl ItemsSource="{Binding Blocks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,1" Opacity="{Binding Opacity}" Orientation="Horizontal">
                                        <TextBlock Width="18" Text="{Binding Symbol}" />
                                        <TextBlock Width="96" Text="{Binding Window}" />
                                        <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <TextBlock Margin="12,8,12,0" FontSize="11" Opacity="0.65" Text="{Binding Footer}" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DataTemplate>

    <!--  Fenster „NINA-PM Protokoll“: Kopfzeile mit Schaltern und Zählern, Tabelle mit Spalte „Ist“.  -->
    <DataTemplate x:Key="NinaPm.Nina.Dock.NightLogVM_Dockable">
        <Grid>
            <TextBlock Margin="12" Opacity="0.75" Text="{Binding Placeholder}" TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasRuntime}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <DockPanel Visibility="{Binding HasRuntime, Converter={StaticResource NinaPm.Dock.BoolToVisibility}}">
                <Border Padding="10,6" Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                        DockPanel.Dock="Top">
                    <DockPanel>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" DockPanel.Dock="Right" Opacity="0.8" Text="{Binding Counters}" />
                        <WrapPanel>
                            <CheckBox Margin="0,2,14,2" VerticalAlignment="Center" Content="{Binding FollowLabel}" IsChecked="{Binding Follow}" />
                            <CheckBox Margin="0,2,14,2" VerticalAlignment="Center" Content="{Binding OnlyExposuresLabel}" IsChecked="{Binding OnlyExposures}" />
                            <Button Style="{DynamicResource NinaPm.ButtonSmall}" Margin="0,2,8,2" Command="{Binding CopyCommand}" Content="{Binding CopyLabel}" />
                            <TextBlock Margin="0,2,0,2" VerticalAlignment="Center" Opacity="0.7" Text="{Binding CopyStatus}" />
                        </WrapPanel>
                    </DockPanel>
                </Border>
                <TextBlock Margin="10,4" DockPanel.Dock="Bottom" FontSize="11" Opacity="0.65" Text="{Binding Legend}" />
                <DataGrid AutoGenerateColumns="False" CanUserAddRows="False" FontFamily="Consolas" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          IsReadOnly="True" ItemsSource="{Binding Rows}" Loaded="OnLogLoaded" MinColumnWidth="40" SelectionMode="Extended">
                    <DataGrid.ColumnHeaderStyle>
                        <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                            <Setter Property="Padding" Value="8,3" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="22" />
                            <Setter Property="Opacity" Value="{Binding Opacity}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                    <Setter Property="Background" Value="#55D8A54A" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style BasedOn="{StaticResource {x:Type DataGridCell}}" TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8,1" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Actual}" Header="{x:Static ui:Texts.LogActual}" />
                        <DataGridTextColumn Binding="{Binding Time}" Header="{x:Static ui:Texts.LogTime}" />
                        <DataGridTextColumn Binding="{Binding Cmd}" Header="{x:Static ui:Texts.LogCmd}" />
                        <DataGridTextColumn Binding="{Binding Target}" Header="{x:Static ui:Texts.LogTarget}" />
                        <DataGridTextColumn Binding="{Binding Panel}" Header="{x:Static ui:Texts.LogPanel}" />
                        <DataGridTextColumn Binding="{Binding No}" Header="{x:Static ui:Texts.LogNo}" />
                        <DataGridTextColumn Binding="{Binding Filter}" Header="{x:Static ui:Texts.LogFilter}" />
                        <DataGridTextColumn Binding="{Binding Exposure}" Header="{x:Static ui:Texts.LogExposure}" />
                        <DataGridTextColumn Binding="{Binding Gain}" Header="{x:Static ui:Texts.LogGain}" />
                        <DataGridTextColumn Binding="{Binding Offset}" Header="{x:Static ui:Texts.LogOffset}" />
                        <DataGridTextColumn Binding="{Binding Binning}" Header="{x:Static ui:Texts.LogBinning}" />
                        <DataGridTextColumn Binding="{Binding Readout}" Header="{x:Static ui:Texts.LogReadout}" />
                        <DataGridTextColumn Binding="{Binding Rotation}" Header="{x:Static ui:Texts.LogRotation}" />
                        <DataGridTextColumn Binding="{Binding Ra}" Header="{x:Static ui:Texts.LogRa}" />
                        <DataGridTextColumn Binding="{Binding Dec}" Header="{x:Static ui:Texts.LogDec}" />
                        <DataGridTextColumn Binding="{Binding Alt}" Header="{x:Static ui:Texts.LogAlt}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Grid>
    </DataTemplate>
</ResourceDictionary>
