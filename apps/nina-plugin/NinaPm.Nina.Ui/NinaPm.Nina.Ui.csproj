<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Ansichten des Plugins (TK 10.1/10.2): WPF mit XAML – die einzige Stelle mit XAML-Dateien (Regel 13). Ohne Windows
    baubar (ADR-S2c), läuft nur auf Windows. AP-16a: Optionsseite mit *Verbindung testen*. Bindet nur über Namen an
    das Plugin-Objekt aus NinaPm.Nina; NinaPm.Nina referenziert dieses Projekt und exportiert die Vorlagen.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>NinaPm.Nina.Ui</RootNamespace>
    <AssemblyName>NinaPm.Nina.Ui</AssemblyName>
    <!-- TK 10.5: Ausgabe ohne Unterordner, ohne deps.json/runtimeconfig.json – sonst findet NINA das Plugin nicht. -->
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <GenerateRuntimeConfigurationFiles>false</GenerateRuntimeConfigurationFiles>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' and '$(OS)' == 'Windows_NT'">
    <OutputPath>$(LOCALAPPDATA)\NINA\Plugins\3.0.0\Svenesis.NinaPm\</OutputPath>
  </PropertyGroup>
  <ItemGroup>
    <!-- Nur zum Übersetzen (Stile und Steuerelemente aus NINA), ausgeliefert wird nichts davon (ADR-S2c). -->
    <PackageReference Include="NINA.Plugin" Version="$(NinaVersion)" IncludeAssets="compile" />
  </ItemGroup>
</Project>
