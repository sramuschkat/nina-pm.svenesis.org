<ResourceDictionary
    x:Class="NinaPm.Nina.Ui.Sequencer.SequencerTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:NinaPm.Nina.Ui"
    xmlns:view="clr-namespace:NINA.View.Sequencer;assembly=NINA.Sequencer"
    xmlns:mini="clr-namespace:NINA.View.Sequencer.MiniSequencer;assembly=NINA.Sequencer"
    xmlns:behaviors="clr-namespace:NINA.Sequencer.Behaviors;assembly=NINA.Sequencer"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors">
    <!--
        Ansichten der Sequenz-Bausteine (execution.md §1). Ohne DataType, weil diese Assembly die Typen aus NinaPm.Nina
        nicht kennt (NinaPm.Nina referenziert NinaPm.Nina.Ui); NinaPmResources ordnet die Schlüssel "NinaPm.*" den Typen
        zu (DataTemplateKey). Die Mini-Ansichten sucht NINA selbst über den Schlüssel "<voller Typname>_Mini".
    -->
    <!-- Rotes Banner im Testbetrieb (execution.md §9): Wert aus packages/ui-tokens, Token `danger` (hell). -->
    <SolidColorBrush x:Key="NinaPm.DangerBrush" Color="#b3261e" />
    <SolidColorBrush x:Key="NinaPm.OnDangerBrush" Color="#ffffff" />
    <BooleanToVisibilityConverter x:Key="NinaPm.BoolToVisibility" />
    <ui:NullToVisibility x:Key="NinaPm.NullToVisible" Invert="True" />

    <!-- Live-Status-Kopf (FA-NIN-13): eigene Vorlage, damit der Adapter-Test sie ohne NINAs Sequenzansicht rendert. -->
    <DataTemplate x:Key="NinaPm.LiveStatus">
        <StackPanel Orientation="Vertical">
            <Border Margin="0,2" Padding="6,3" Background="{StaticResource NinaPm.DangerBrush}"
                    Visibility="{Binding TestBanner, Converter={StaticResource NinaPm.BoolToVisibility}}">
                <TextBlock FontWeight="Bold" Foreground="{StaticResource NinaPm.OnDangerBrush}" Text="{Binding TestBannerText}" />
            </Border>
            <WrapPanel Margin="0,2" Orientation="Horizontal">
                <TextBlock Margin="0,0,12,0" FontWeight="Bold" Text="{Binding StateText}" />
                <TextBlock Margin="0,0,12,0" Text="{Binding TargetText}" />
                <TextBlock Margin="0,0,12,0" Opacity="0.8" Text="{Binding CoordinatesText}" />
                <TextBlock Margin="0,0,12,0" Opacity="0.8" Text="{Binding RotationText}" />
            </WrapPanel>
            <TextBlock Margin="0,2" Foreground="{StaticResource NinaPm.DangerBrush}" Text="{Binding BlockedText}" TextWrapping="Wrap"
                       Visibility="{Binding IsBlocked, Converter={StaticResource NinaPm.BoolToVisibility}}" />
            <TextBlock Margin="0,2" Text="{Binding ExposureText}" />
            <TextBlock Margin="0,2" Opacity="0.7" Text="{Binding CountersText}" />
            <Expander Margin="0,4,0,0" Header="{x:Static ui:Texts.TodayTargets}">
                <ItemsControl ItemsSource="{Binding Blocks}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Window}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Opacity="0.8" Text="{Binding StateText}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Expander>
        </StackPanel>
    </DataTemplate>

    <!-- Live-Status im Container (FA-NIN-13, AP-16h): Kopf, Zähler, Bedienung, „Heutige Ziele“. -->
    <DataTemplate x:Key="NinaPm.Container">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <StackPanel Orientation="Vertical">
                    <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="{x:Static ui:Texts.ContainerHint}" TextWrapping="Wrap"
                               Visibility="{Binding Live, Converter={StaticResource NinaPm.NullToVisible}}" />
                    <ContentControl Content="{Binding Live}" ContentTemplate="{StaticResource NinaPm.LiveStatus}" />
                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                        <Button Padding="8,2" Command="{Binding ResetPlanCommand}">
                            <TextBlock Foreground="{DynamicResource ButtonForegroundBrush}" Text="{x:Static ui:Texts.Reset}" />
                        </Button>
                        <Button Margin="6,0,0,0" Padding="8,2" Command="{Binding SkipBlockCommand}">
                            <TextBlock Foreground="{DynamicResource ButtonForegroundBrush}" Text="{x:Static ui:Texts.SkipBlock}" />
                        </Button>
                    </StackPanel>
                </StackPanel>
            </view:SequenceBlockView.SequenceItemContent>
            <view:SequenceBlockView.SequenceItemProgressContent>
                <TextBlock VerticalAlignment="Center" Text="{Binding Target.TargetName}" />
            </view:SequenceBlockView.SequenceItemProgressContent>
        </view:SequenceBlockView>
    </DataTemplate>

    <DataTemplate x:Key="NinaPm.NightLoopCondition">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="{x:Static ui:Texts.NightLoopHint}" />
            </view:SequenceBlockView.SequenceItemContent>
        </view:SequenceBlockView>
    </DataTemplate>

    <DataTemplate x:Key="NinaPm.Nina.Sequencer.NightLoopCondition_Mini">
        <mini:MiniCondition />
    </DataTemplate>

    <DataTemplate x:Key="NinaPm.SafetyWait">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="{x:Static ui:Texts.SafetyWaitHint}" />
            </view:SequenceBlockView.SequenceItemContent>
        </view:SequenceBlockView>
    </DataTemplate>

    <DataTemplate x:Key="NinaPm.Nina.Sequencer.SafetyWaitInstruction_Mini">
        <mini:MiniSequenceItem />
    </DataTemplate>

    <DataTemplate x:Key="NinaPm.Nina.Sequencer.NinaPmContainer_Mini">
        <mini:MiniSequenceItem />
    </DataTemplate>
    <!-- Trigger-Sets vor/nach jeder Belichtung (FA-NIN-16); Box nach dem Astro-PM-Plugin (Views/SequenceTemplates.xaml, Commit 5dd621d, MIT). -->
    <DataTemplate x:Key="NinaPm.BeforeExposureTrigger">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <StackPanel Margin="0,2" Orientation="Vertical">
                    <TextBlock Margin="0,0,0,4" Opacity="0.6" FontStyle="Italic" Text="{x:Static ui:Texts.BeforeExposureHint}" />
                    <Border MinHeight="35" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid Background="{StaticResource BackgroundBrush}" DataContext="{Binding TriggerRunner}">
                            <ItemsControl MinHeight="35" ItemsSource="{Binding Items}" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic" Opacity="0.4"
                                       Text="{x:Static ui:Texts.DropInstructionsHint}"
                                       Visibility="{Binding Items.Count, Converter={StaticResource InverseZeroToVisibilityConverter}}" />
                            <i:Interaction.Behaviors>
                                <behaviors:DragOverBehavior DragAboveSize="0" DragBelowSize="0" />
                                <behaviors:DropIntoBehavior AllowedDragDropTypesString="NINA.Sequencer.Container.ISequenceContainer;NINA.Sequencer.SequenceItem.ISequenceItem;NINA.Sequencer.TemplatedSequenceContainer" OnDropCommand="DropIntoCommand" />
                            </i:Interaction.Behaviors>
                        </Grid>
                    </Border>
                </StackPanel>
            </view:SequenceBlockView.SequenceItemContent>
        </view:SequenceBlockView>
    </DataTemplate>

    <DataTemplate x:Key="NinaPm.Nina.Sequencer.BeforeExposureTrigger_Mini">
        <mini:MiniSequenceItem />
    </DataTemplate>

    <DataTemplate x:Key="NinaPm.AfterExposureTrigger">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <StackPanel Margin="0,2" Orientation="Vertical">
                    <TextBlock Margin="0,0,0,4" Opacity="0.6" FontStyle="Italic" Text="{x:Static ui:Texts.AfterExposureHint}" />
                    <Border MinHeight="35" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid Background="{StaticResource BackgroundBrush}" DataContext="{Binding TriggerRunner}">
                            <ItemsControl MinHeight="35" ItemsSource="{Binding Items}" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic" Opacity="0.4"
                                       Text="{x:Static ui:Texts.DropInstructionsHint}"
                                       Visibility="{Binding Items.Count, Converter={StaticResource InverseZeroToVisibilityConverter}}" />
                            <i:Interaction.Behaviors>
                                <behaviors:DragOverBehavior DragAboveSize="0" DragBelowSize="0" />
                                <behaviors:DropIntoBehavior AllowedDragDropTypesString="NINA.Sequencer.Container.ISequenceContainer;NINA.Sequencer.SequenceItem.ISequenceItem;NINA.Sequencer.TemplatedSequenceContainer" OnDropCommand="DropIntoCommand" />
                            </i:Interaction.Behaviors>
                        </Grid>
                    </Border>
                </StackPanel>
            </view:SequenceBlockView.SequenceItemContent>
        </view:SequenceBlockView>
    </DataTemplate>

    <DataTemplate x:Key="NinaPm.Nina.Sequencer.AfterExposureTrigger_Mini">
        <mini:MiniSequenceItem />
    </DataTemplate>

    <!-- Trigger-Sets vor/nach Zielwechsel (FA-NIN-16), Box wie oben. -->
    <DataTemplate x:Key="NinaPm.BeforeTargetChangeTrigger">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <StackPanel Margin="0,2" Orientation="Vertical">
                    <TextBlock Margin="0,0,0,4" Opacity="0.6" FontStyle="Italic" Text="{x:Static ui:Texts.BeforeTargetChangeHint}" />
                    <Border MinHeight="35" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid Background="{StaticResource BackgroundBrush}" DataContext="{Binding TriggerRunner}">
                            <ItemsControl MinHeight="35" ItemsSource="{Binding Items}" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic" Opacity="0.4"
                                       Text="{x:Static ui:Texts.DropInstructionsHint}"
                                       Visibility="{Binding Items.Count, Converter={StaticResource InverseZeroToVisibilityConverter}}" />
                            <i:Interaction.Behaviors>
                                <behaviors:DragOverBehavior DragAboveSize="0" DragBelowSize="0" />
                                <behaviors:DropIntoBehavior AllowedDragDropTypesString="NINA.Sequencer.Container.ISequenceContainer;NINA.Sequencer.SequenceItem.ISequenceItem;NINA.Sequencer.TemplatedSequenceContainer" OnDropCommand="DropIntoCommand" />
                            </i:Interaction.Behaviors>
                        </Grid>
                    </Border>
                </StackPanel>
            </view:SequenceBlockView.SequenceItemContent>
        </view:SequenceBlockView>
    </DataTemplate>

    <DataTemplate x:Key="NinaPm.Nina.Sequencer.BeforeTargetChangeTrigger_Mini">
        <mini:MiniSequenceItem />
    </DataTemplate>

    <DataTemplate x:Key="NinaPm.AfterTargetChangeTrigger">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <StackPanel Margin="0,2" Orientation="Vertical">
                    <TextBlock Margin="0,0,0,4" Opacity="0.6" FontStyle="Italic" Text="{x:Static ui:Texts.AfterTargetChangeHint}" />
                    <Border MinHeight="35" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
                        <Grid Background="{StaticResource BackgroundBrush}" DataContext="{Binding TriggerRunner}">
                            <ItemsControl MinHeight="35" ItemsSource="{Binding Items}" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontStyle="Italic" Opacity="0.4"
                                       Text="{x:Static ui:Texts.DropInstructionsHint}"
                                       Visibility="{Binding Items.Count, Converter={StaticResource InverseZeroToVisibilityConverter}}" />
                            <i:Interaction.Behaviors>
                                <behaviors:DragOverBehavior DragAboveSize="0" DragBelowSize="0" />
                                <behaviors:DropIntoBehavior AllowedDragDropTypesString="NINA.Sequencer.Container.ISequenceContainer;NINA.Sequencer.SequenceItem.ISequenceItem;NINA.Sequencer.TemplatedSequenceContainer" OnDropCommand="DropIntoCommand" />
                            </i:Interaction.Behaviors>
                        </Grid>
                    </Border>
                </StackPanel>
            </view:SequenceBlockView.SequenceItemContent>
        </view:SequenceBlockView>
    </DataTemplate>

    <DataTemplate x:Key="NinaPm.Nina.Sequencer.AfterTargetChangeTrigger_Mini">
        <mini:MiniSequenceItem />
    </DataTemplate>

    <!-- Ziele aktualisieren (FA-NIN-08). -->
    <DataTemplate x:Key="NinaPm.RefreshTargets">
        <view:SequenceBlockView>
            <view:SequenceBlockView.SequenceItemContent>
                <TextBlock VerticalAlignment="Center" Opacity="0.7" Text="{x:Static ui:Texts.RefreshTargetsHint}" />
            </view:SequenceBlockView.SequenceItemContent>
            <view:SequenceBlockView.SequenceItemProgressContent>
                <TextBlock VerticalAlignment="Center" Text="{Binding StatusText}" />
            </view:SequenceBlockView.SequenceItemProgressContent>
        </view:SequenceBlockView>
    </DataTemplate>

    <DataTemplate x:Key="NinaPm.Nina.Sequencer.RefreshTargetsInstruction_Mini">
        <mini:MiniSequenceItem />
    </DataTemplate>
</ResourceDictionary>
