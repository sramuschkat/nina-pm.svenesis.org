<ResourceDictionary
    x:Class="NinaPm.Nina.Ui.Options.OptionsTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="clr-namespace:NinaPm.Nina.Ui"
    xmlns:options="clr-namespace:NinaPm.Nina.Ui.Options">
    <!--
        Optionsseite (FA-NIN-01, AP-16a, P-04): NINA sucht die Vorlage unter "<Plugin-Name>_Options"; DataContext ist
        das Plugin-Objekt aus NinaPm.Nina (Bindungen nur über Namen). Das Token geht über eine PasswordBox und wird nie
        angezeigt (SV-08).
    -->
    <BooleanToVisibilityConverter x:Key="NinaPm.BoolToVisibility" />
    <DataTemplate x:Key="NINA-PM_Options">
        <StackPanel Margin="5" Orientation="Vertical">
            <TextBlock Margin="0,0,0,10" MaxWidth="700" HorizontalAlignment="Left" Text="{x:Static ui:Texts.Intro}" TextWrapping="Wrap" />
            <TextBlock Margin="0,0,0,5" FontWeight="Bold" Text="{x:Static ui:Texts.ConnectionHeader}" />
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="420" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{x:Static ui:Texts.ServerUrl}" />
                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2" Text="{Binding ServerUrl, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="{x:Static ui:Texts.Token}" />
                <PasswordBox
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="0,2"
                    options:PasswordBoxBinding.Attach="True"
                    options:PasswordBoxBinding.Password="{Binding TokenInput, Mode=TwoWay}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,0,0,4" Opacity="0.7" Text="{Binding TokenState}" />
                <!--  NINAs Stil zeigt eine CheckBox als Schalter ohne Content: Beschriftung daher als eigene Zeile.  -->
                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="{x:Static ui:Texts.TestMode}" />
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,2" Orientation="Horizontal">
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding TestMode}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.7" Text="{x:Static ui:Texts.TestModeHint}" />
                </StackPanel>
            </Grid>
            <StackPanel Margin="0,5" Orientation="Horizontal">
                <!--  Schriftfarbe aus NINAs Thema (ButtonForegroundBrush); ohne sie schwarz auf dunklem Grund.  -->
                <Button Padding="10,4" Command="{Binding SaveAndTestCommand}">
                    <TextBlock Foreground="{DynamicResource ButtonForegroundBrush}" Text="{x:Static ui:Texts.SaveAndConnect}" />
                </Button>
                <Button Margin="8,0,0,0" Padding="10,4" Command="{Binding TestCommand}">
                    <TextBlock Foreground="{DynamicResource ButtonForegroundBrush}" Text="{x:Static ui:Texts.TestConnection}" />
                </Button>
            </StackPanel>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="{x:Static ui:Texts.Status}" />
                <TextBlock Grid.Row="0" Grid.Column="1" FontWeight="Bold" Text="{Binding ConnectionStatus}" TextWrapping="Wrap" />
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static ui:Texts.Tenant}" />
                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding TenantName}" />
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{x:Static ui:Texts.Instance}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InstanceName}" />
                <TextBlock Grid.Row="3" Grid.Column="0" Text="{x:Static ui:Texts.Rig}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding RigName}" />
                <!--  Teleskop und Kamera des Rigs (wie die Rig-Zeile des Astro-PM-Plugins); das Rig legt das Sync-Token fest.  -->
                <TextBlock Grid.Row="4" Grid.Column="0" Text="{x:Static ui:Texts.Telescope}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TelescopeName}" />
                <TextBlock Grid.Row="5" Grid.Column="0" Text="{x:Static ui:Texts.Camera}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding CameraName}" />
                <TextBlock Grid.Row="6" Grid.Column="0" VerticalAlignment="Center" Text="{x:Static ui:Texts.Site}" />
                <!--  FA-NIN-03: bei > 10 km Knopf, der den Rig-Standort nach Rückfrage ins aktive Profil schreibt.  -->
                <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Text="{Binding SiteCheck}" TextWrapping="Wrap" />
                    <Button Margin="12,0,0,0" Padding="8,2" Command="{Binding ApplySiteCommand}" Content="{x:Static ui:Texts.ApplySite}"
                            Visibility="{Binding SiteMismatch, Converter={StaticResource NinaPm.BoolToVisibility}}" />
                </StackPanel>
            </Grid>
            <!--  Betrieb (AP-16g, FA-NIN-04/13): Offline-Modus, Zurücksetzen, Block überspringen, Erneut hochladen.  -->
            <TextBlock Margin="0,15,0,5" FontWeight="Bold" Text="{x:Static ui:Texts.OperationHeader}" />
            <Grid Margin="0,0,0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="{x:Static ui:Texts.OfflineMode}" />
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,2" Orientation="Horizontal">
                    <CheckBox VerticalAlignment="Center" IsChecked="{Binding OfflineMode}" />
                    <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Opacity="0.7" Text="{x:Static ui:Texts.OfflineModeHint}" />
                </StackPanel>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="{x:Static ui:Texts.Status}" />
                <TextBlock Grid.Row="1" Grid.Column="1" FontWeight="Bold" Text="{Binding OperationStatus}" TextWrapping="Wrap" />
                <StackPanel Grid.Row="2" Grid.Column="1">
                    <TextBlock Opacity="0.7" Text="{Binding DeadLetterInfo}" TextWrapping="Wrap" />
                    <TextBlock Margin="0,2,0,4" Opacity="0.7" Text="{x:Static ui:Texts.OutboxHelp}" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="{x:Static ui:Texts.ReuploadFrom}" />
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="0,2" Orientation="Horizontal">
                    <DatePicker Width="140" SelectedDate="{Binding ReuploadFrom}" />
                    <Button Margin="8,0,0,0" Padding="10,4" Command="{Binding ReuploadCommand}">
                        <TextBlock Foreground="{DynamicResource ButtonForegroundBrush}" Text="{x:Static ui:Texts.Reupload}" />
                    </Button>
                </StackPanel>
            </Grid>
            <StackPanel Margin="0,5" Orientation="Horizontal">
                <Button Padding="10,4" Command="{Binding ResetCommand}">
                    <TextBlock Foreground="{DynamicResource ButtonForegroundBrush}" Text="{x:Static ui:Texts.Reset}" />
                </Button>
                <Button Margin="8,0,0,0" Padding="10,4" Command="{Binding SkipBlockCommand}">
                    <TextBlock Foreground="{DynamicResource ButtonForegroundBrush}" Text="{x:Static ui:Texts.SkipBlock}" />
                </Button>
                <Button Margin="8,0,0,0" Padding="10,4" Command="{Binding RefreshCommand}">
                    <TextBlock Foreground="{DynamicResource ButtonForegroundBrush}" Text="{x:Static ui:Texts.Refresh}" />
                </Button>
            </StackPanel>
            <!--  Zielbrowser „An NINA ausgeliefert“ (FA-NIN-02, AP-16h).  -->
            <StackPanel DataContext="{Binding Targets}" Orientation="Vertical">
                <TextBlock Margin="0,15,0,5" FontWeight="Bold" Text="{x:Static ui:Texts.TargetsHeader}" />
                <TextBlock Margin="0,0,0,5" Opacity="0.7" Text="{x:Static ui:Texts.TargetsHint}" TextWrapping="Wrap" />
                <StackPanel Margin="0,0,0,5" Orientation="Horizontal">
                    <ComboBox Width="140" ItemsSource="{Binding Types}" SelectedIndex="{Binding TypeIndex}" />
                    <CheckBox Margin="12,0,0,0" VerticalAlignment="Center" IsChecked="{Binding OpenOnly}" />
                    <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Text="{x:Static ui:Texts.OpenOnly}" />
                    <Button Margin="12,0,0,0" Padding="10,4" Command="{Binding RefreshCommand}">
                        <TextBlock Foreground="{DynamicResource ButtonForegroundBrush}" Text="{x:Static ui:Texts.Refresh}" />
                    </Button>
                    <Button Margin="8,0,0,0" Padding="10,4" Command="{Binding LoadCommand}">
                        <TextBlock Foreground="{DynamicResource ButtonForegroundBrush}" Text="{x:Static ui:Texts.LoadIntoFraming}" />
                    </Button>
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7" Text="{Binding Status}" />
                </StackPanel>
                <DataGrid MaxHeight="300" AutoGenerateColumns="False" CanUserAddRows="False" GridLinesVisibility="Horizontal" HeadersVisibility="Column"
                          IsReadOnly="True" ItemsSource="{Binding Rows}" MinColumnWidth="44" SelectedItem="{Binding Selected}" SelectionMode="Single">
                    <!--  Spaltenköpfe mit Abstand und kompakte Zeilen wie im Planprotokoll.  -->
                    <DataGrid.ColumnHeaderStyle>
                        <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                            <Setter Property="Padding" Value="8,3" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
                            <Setter Property="MinHeight" Value="24" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.CellStyle>
                        <Style BasedOn="{StaticResource {x:Type DataGridCell}}" TargetType="DataGridCell">
                            <Setter Property="Padding" Value="8,2" />
                            <Setter Property="TextBlock.TextAlignment" Value="Left" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="DataGridCell">
                                        <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                            <ContentPresenter VerticalAlignment="Center" />
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Name}" Header="{x:Static ui:Texts.ColTarget}" />
                        <DataGridTextColumn Binding="{Binding Ra}" Header="RA" />
                        <DataGridTextColumn Binding="{Binding Dec}" Header="Dec" />
                        <DataGridTextColumn Binding="{Binding Rotation}" Header="{x:Static ui:Texts.ColRotation}" />
                        <DataGridTextColumn Binding="{Binding Panels}" Header="{x:Static ui:Texts.ColPanels}" />
                        <DataGridTextColumn Binding="{Binding FocalLength}" Header="{x:Static ui:Texts.ColFocalLength}" />
                        <DataGridTextColumn Binding="{Binding Sensor}" Header="{x:Static ui:Texts.ColSensor}" />
                        <DataGridTextColumn Binding="{Binding Pixel}" Header="{x:Static ui:Texts.ColPixel}" />
                        <DataGridTextColumn Binding="{Binding Priority}" Header="{x:Static ui:Texts.ColPriority}" />
                        <DataGridTextColumn Binding="{Binding Type}" Header="{x:Static ui:Texts.ColType}" />
                        <DataGridTextColumn Binding="{Binding Progress}" Header="{x:Static ui:Texts.ColProgress}" />
                        <DataGridTextColumn Binding="{Binding NextTransit}" Header="{x:Static ui:Texts.ColNextTransit}" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
            <!--
                Simulator (FA-NIN-18, AP-53) mit der Gliederung von S-40: Infobox, Schritt 1 gesperrte Einstellungen, Lauf-Leiste,
                Schritt 2 Zielkarten, Schritt 3 Plangrafik und Planprotokoll. Es rechnet immer der Server. Gliederung, Lauf-Leiste
                mit Statuspunkt, Schloss-Karte und Zielkarten nach Views/SimulatorPanel.xaml des Astro-PM-NINA-Plugins (MIT,
                Commit 5dd621d). NINA-Pinsel nur als DynamicResource (keine StaticResource-Abhängigkeit von NINA).
            -->
            <StackPanel Margin="0,15,0,0" DataContext="{Binding Simulator}" Orientation="Vertical">
                <TextBlock Margin="0,0,0,5" FontWeight="Bold" Text="{x:Static ui:Texts.SimulatorHeader}" />
                <Border MaxWidth="1000" Margin="0,0,0,8" Padding="10,6" HorizontalAlignment="Left" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="{Binding Info}" TextWrapping="Wrap" />
                        <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <TextBlock VerticalAlignment="Center" Text="{x:Static ui:Texts.SamplesDownload}" />
                            <ItemsControl ItemsSource="{Binding Samples}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Margin="8,0,0,0" Padding="8,2" Command="{Binding OpenCommand}" ToolTip="{Binding Url}">
                                            <TextBlock Foreground="{DynamicResource ButtonForegroundBrush}" Text="{Binding Name}" />
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!--  Schritt 1: gesperrte Einstellungen (nur Anzeige, abgeblendet) mit Schloss-Karte daneben.  -->
                <TextBlock Margin="0,4,0,4" FontWeight="SemiBold" Text="{x:Static ui:Texts.Step1}" />
                <Border MaxWidth="1000" Padding="10,8" HorizontalAlignment="Left" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                        CornerRadius="4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" IsEnabled="False" Opacity="0.6">
                            <ItemsControl ItemsSource="{Binding Settings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,1">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="220" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Label}" />
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Margin="0,4,0,0" Opacity="0.8" Text="{Binding SettingsVersionText}" TextWrapping="Wrap" />
                        </StackPanel>
                        <Border Grid.Column="1" Width="360" Margin="12,0,0,0" Padding="12,8" VerticalAlignment="Top"
                                Background="{DynamicResource BackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                CornerRadius="6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <!--  Schloss-Symbol (Pfad wie in Views/SimulatorPanel.xaml, Astro-PM-NINA-Plugin, MIT, 5dd621d).  -->
                                <Path Grid.Column="0" Width="18" Height="18" Margin="0,1,10,0" VerticalAlignment="Top"
                                      Data="M12,17A2,2 0 0,0 14,15A2,2 0 0,0 12,13A2,2 0 0,0 10,15A2,2 0 0,0 12,17M18,8A2,2 0 0,1 20,10V20A2,2 0 0,1 18,22H6A2,2 0 0,1 4,20V10A2,2 0 0,1 6,8H7V6A5,5 0 0,1 12,1A5,5 0 0,1 17,6V8H18M12,3A3,3 0 0,0 9,6V8H15V6A3,3 0 0,0 12,3Z"
                                      Fill="{DynamicResource PrimaryBrush}" Stretch="Uniform" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Margin="0,0,0,4" FontWeight="SemiBold" Text="{Binding LockedTitle}" TextWrapping="Wrap" />
                                    <TextBlock Opacity="0.8" Text="{Binding LockedHint}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!--  Lauf-Leiste: ◀ Nacht ▶, Heute Nacht, Simulieren, Kopfzahlen; Statuspunkt, „Ziele zuletzt abgerufen“, Status.  -->
                <Border MaxWidth="1000" Margin="0,8,0,8" Padding="10,6" HorizontalAlignment="Left" BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1" CornerRadius="4">
                    <StackPanel>
                        <WrapPanel Orientation="Horizontal">
                            <TextBlock Margin="0,0,6,0" VerticalAlignment="Center" Text="{x:Static ui:Texts.Night}" />
                            <Button Padding="8,2" Command="{Binding PrevCommand}" ToolTip="{x:Static ui:Texts.PrevNight}">
                                <TextBlock Foreground="{DynamicResource ButtonForegroundBrush}" Text="◀" />
                            </Button>
                            <TextBlock Width="150" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding NightText}" TextAlignment="Center" />
                            <Button Padding="8,2" Command="{Binding NextCommand}" ToolTip="{x:Static ui:Texts.NextNight}">
                                <TextBlock Foreground="{DynamicResource ButtonForegroundBrush}" Text="▶" />
                            </Button>
                            <Button Margin="8,0,0,0" Padding="10,2" Command="{Binding TonightCommand}">
                                <TextBlock Foreground="{DynamicResource ButtonForegroundBrush}" Text="{x:Static ui:Texts.Tonight}" />
                            </Button>
                            <Button Margin="16,0,0,0" Padding="14,2" Command="{Binding SimulateCommand}">
                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource ButtonForegroundBrush}" Text="{x:Static ui:Texts.Simulate}" />
                            </Button>
                            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.8" Text="{Binding SummaryText}" />
                        </WrapPanel>
                        <WrapPanel Margin="0,6,0,0" Orientation="Horizontal">
                            <Ellipse Width="10" Height="10" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding StatusBrush}" />
                            <TextBlock VerticalAlignment="Center" Opacity="0.75" Text="{Binding FetchedText}" />
                            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" FontWeight="Bold" Text="{Binding Status}" TextWrapping="Wrap" />
                            <TextBlock Margin="16,0,0,0" VerticalAlignment="Center" Opacity="0.6" Text="{Binding ComputedText}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding HasResults, Converter={StaticResource NinaPm.BoolToVisibility}}">
                    <!--  Schritt 2: Zielkarten und nicht zugeteilte Projekte (FA-SIM-03, FA-SIM-06).  -->
                    <TextBlock Margin="0,4,0,4" FontWeight="SemiBold" Text="{x:Static ui:Texts.Step2}" />
                    <TextBlock Margin="0,0,0,6" Opacity="0.75" Text="{Binding EmptyText}"
                               Visibility="{Binding IsEmpty, Converter={StaticResource NinaPm.BoolToVisibility}}" />
                    <ItemsControl MaxWidth="1400" HorizontalAlignment="Left" ItemsSource="{Binding Cards}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!--  Zielkarte wie im Web-Simulator: Punkt in Zielfarbe, Kennzahlen, Filter-Chips, Prüfliste.  -->
                                <Border Width="360" Margin="0,0,10,10" Padding="14,10" Background="{DynamicResource SecondaryBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <StackPanel>
                                        <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                            <Ellipse Width="11" Height="11" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding ColorBrush}" />
                                            <TextBlock FontSize="14" FontWeight="SemiBold" Text="{Binding Name}" />
                                            <Border Margin="8,0,0,0" Padding="6,0" VerticalAlignment="Center" BorderBrush="{Binding ColorBrush}"
                                                    BorderThickness="1" CornerRadius="6"
                                                    Visibility="{Binding Transit, Converter={StaticResource NinaPm.BoolToVisibility}}">
                                                <TextBlock FontSize="10" Text="{Binding TransitLabel}" />
                                            </Border>
                                        </StackPanel>
                                        <ItemsControl ItemsSource="{Binding Facts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="110" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Grid.Column="0" Opacity="0.7" Text="{Binding Label}" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Flips}"
                                                      Visibility="{Binding HasFlips, Converter={StaticResource NinaPm.BoolToVisibility}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock FontWeight="SemiBold" Foreground="{Binding DataContext.FlipBrush, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                               Text="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Margin="0,10,0,4" FontSize="10.5" FontWeight="SemiBold" Opacity="0.65" Text="{Binding LinesHeader}" />
                                        <ItemsControl ItemsSource="{Binding Lines}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,2" Opacity="{Binding Opacity}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="60" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border Grid.Column="0" Margin="0,0,8,0" Padding="4,1" VerticalAlignment="Top" Background="{Binding ChipBrush}"
                                                                CornerRadius="3">
                                                            <TextBlock HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{Binding ChipForeground}"
                                                                       Text="{Binding Chip}" TextTrimming="CharacterEllipsis" />
                                                        </Border>
                                                        <StackPanel Grid.Column="1">
                                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" />
                                                            <Border Margin="0,2,0,0" Padding="6,0" HorizontalAlignment="Left" BorderBrush="{Binding MoonBrush}" BorderThickness="1"
                                                                    CornerRadius="8" Visibility="{Binding HasMoon, Converter={StaticResource NinaPm.BoolToVisibility}}">
                                                                <TextBlock FontSize="10" Foreground="{Binding MoonBrush}" Text="{Binding MoonText}" />
                                                            </Border>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Border Margin="0,6,0,0" Padding="6,3" BorderBrush="{Binding ColorBrush}" BorderThickness="1" CornerRadius="3"
                                                Visibility="{Binding Transit, Converter={StaticResource NinaPm.BoolToVisibility}}">
                                            <TextBlock FontSize="11" Text="{Binding TransitBox}" TextWrapping="Wrap" />
                                        </Border>
                                        <Separator Margin="0,8,0,6" Opacity="0.5" />
                                        <ItemsControl ItemsSource="{Binding Checks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Margin="0,1" Orientation="Horizontal">
                                                        <TextBlock Width="18" FontWeight="Bold" Foreground="{Binding Brush}" Text="{Binding Icon}" />
                                                        <TextBlock Opacity="0.85" Text="{Binding Label}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Margin="0,0,0,8" Visibility="{Binding HasUnallocated, Converter={StaticResource NinaPm.BoolToVisibility}}">
                        <TextBlock FontWeight="SemiBold" Text="{x:Static ui:Texts.Unallocated}" />
                        <ItemsControl ItemsSource="{Binding Unallocated}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Opacity="0.8" Text="{Binding Text}" TextWrapping="Wrap" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!--  Schritt 3: Plangrafik (FA-SIM-07) und Planprotokoll (FA-SIM-08).  -->
                    <TextBlock Margin="0,4,0,2" FontWeight="SemiBold" Text="{x:Static ui:Texts.Step3}" />
                    <TextBlock Margin="0,0,0,4" Opacity="0.75" Text="{Binding PlanHeader}" />
                    <!--  Plangrafik wie im Web-Simulator: dunkler Rahmen, Himmel im Verlauf, Mondfläche, Blöcke als Flächen in Zielfarbe.  -->
                    <Border Margin="0,0,0,8" HorizontalAlignment="Left" Background="{Binding FrameBrush}" CornerRadius="6"
                            DataContext="{Binding Chart}">
                        <Grid Width="{Binding ChartWidth}" Height="{Binding ChartHeight}" ClipToBounds="True">
                            <ItemsControl ItemsSource="{Binding Rects}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="{Binding Width}" Height="{Binding Height}" Background="{Binding Fill}" BorderBrush="{Binding Stroke}"
                                                BorderThickness="{Binding Border}" ToolTip="{Binding ToolTip}">
                                            <TextBlock Margin="{Binding LabelMargin}" VerticalAlignment="{Binding LabelAlignment}" FontSize="{Binding LabelSize}"
                                                       FontWeight="{Binding LabelWeight}" Foreground="{Binding LabelBrush}" Text="{Binding Label}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl IsHitTestVisible="False" ItemsSource="{Binding Polygons}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Polygon Fill="{Binding Fill}" Points="{Binding Points}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl IsHitTestVisible="False" ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Polyline Points="{Binding Points}" Stroke="{Binding Stroke}" StrokeDashArray="{Binding Dash}"
                                                  StrokeThickness="{Binding Thickness}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl IsHitTestVisible="False" ItemsSource="{Binding Labels}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <Canvas />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="Canvas.Left" Value="{Binding Left}" />
                                        <Setter Property="Canvas.Top" Value="{Binding Top}" />
                                    </Style>
                                </ItemsControl.ItemContainerStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="{Binding Padding}" Background="{Binding Background}">
                                            <TextBlock FontSize="{Binding Size}" FontWeight="{Binding Weight}" Foreground="{Binding Foreground}" Text="{Binding Text}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Grid>
                    </Border>
                    <ItemsControl Margin="0,0,0,8" ItemsSource="{Binding Warnings}"
                                  Visibility="{Binding HasWarnings, Converter={StaticResource NinaPm.BoolToVisibility}}" />
                    <StackPanel Margin="0,0,0,4" Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center" FontWeight="SemiBold" Text="{x:Static ui:Texts.Protocol}" />
                        <Button Margin="12,0,0,0" Padding="10,2" Command="{Binding CopyCommand}">
                            <TextBlock Foreground="{DynamicResource ButtonForegroundBrush}" Text="{x:Static ui:Texts.CopyProtocol}" />
                        </Button>
                        <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Opacity="0.7" Text="{Binding CopyStatus}" />
                    </StackPanel>
                    <!--  Planprotokoll: Spalten mit Abstand, Zeilen in Festbreitenschrift wie im Web (S-40).  -->
                    <DataGrid MaxHeight="400" AutoGenerateColumns="False" CanUserAddRows="False" FontFamily="Consolas" GridLinesVisibility="Horizontal"
                              HeadersVisibility="Column" IsReadOnly="True" ItemsSource="{Binding Log}" MinColumnWidth="44" SelectionMode="Extended">
                        <DataGrid.ColumnHeaderStyle>
                            <Style BasedOn="{StaticResource {x:Type DataGridColumnHeader}}" TargetType="DataGridColumnHeader">
                                <Setter Property="Padding" Value="8,3" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Style>
                        </DataGrid.ColumnHeaderStyle>
                        <DataGrid.RowStyle>
                            <Style BasedOn="{StaticResource {x:Type DataGridRow}}" TargetType="DataGridRow">
                                <Setter Property="MinHeight" Value="22" />
                            </Style>
                        </DataGrid.RowStyle>
                        <DataGrid.CellStyle>
                            <Style BasedOn="{StaticResource {x:Type DataGridCell}}" TargetType="DataGridCell">
                                <Setter Property="Padding" Value="8,1" />
                                <Setter Property="TextBlock.TextAlignment" Value="Left" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="DataGridCell">
                                            <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                                <ContentPresenter />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </DataGrid.CellStyle>
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Time}" Header="{x:Static ui:Texts.LogTime}" />
                            <DataGridTextColumn Binding="{Binding Cmd}" Header="{x:Static ui:Texts.LogCmd}" />
                            <DataGridTextColumn Binding="{Binding Target}" Header="{x:Static ui:Texts.LogTarget}" />
                            <DataGridTextColumn Binding="{Binding Panel}" Header="{x:Static ui:Texts.LogPanel}" />
                            <DataGridTextColumn Binding="{Binding No}" Header="{x:Static ui:Texts.LogNo}" />
                            <DataGridTextColumn Binding="{Binding Filter}" Header="{x:Static ui:Texts.LogFilter}" />
                            <DataGridTextColumn Binding="{Binding Exposure}" Header="{x:Static ui:Texts.LogExposure}" />
                            <DataGridTextColumn Binding="{Binding Gain}" Header="{x:Static ui:Texts.LogGain}" />
                            <DataGridTextColumn Binding="{Binding Offset}" Header="{x:Static ui:Texts.LogOffset}" />
                            <DataGridTextColumn Binding="{Binding Binning}" Header="{x:Static ui:Texts.LogBinning}" />
                            <DataGridTextColumn Binding="{Binding Readout}" Header="{x:Static ui:Texts.LogReadout}" />
                            <DataGridTextColumn Binding="{Binding Rotation}" Header="{x:Static ui:Texts.LogRotation}" />
                            <DataGridTextColumn Binding="{Binding Ra}" Header="{x:Static ui:Texts.LogRa}" />
                            <DataGridTextColumn Binding="{Binding Dec}" Header="{x:Static ui:Texts.LogDec}" />
                            <DataGridTextColumn Binding="{Binding Alt}" Header="{x:Static ui:Texts.LogAlt}" />
                            <DataGridTextColumn Binding="{Binding MoonSep}" Header="{x:Static ui:Texts.LogMoonSep}" />
                            <DataGridTextColumn Binding="{Binding MoonOk}" Header="{x:Static ui:Texts.LogMoonOk}" />
                            <DataGridTextColumn Binding="{Binding Required}" Header="{x:Static ui:Texts.LogRequired}" />
                            <DataGridTextColumn Binding="{Binding Dark}" Header="{x:Static ui:Texts.LogDark}" />
                            <DataGridTextColumn Binding="{Binding La}" Header="{x:Static ui:Texts.LogLa}" />
                            <DataGridTextColumn Binding="{Binding Profile}" Header="{x:Static ui:Texts.LogProfile}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </StackPanel>
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
