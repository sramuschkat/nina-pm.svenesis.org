{
  "name": "nina-pm",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "pnpm -r --if-present run build",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present run typecheck",
    "lint": "eslint . --max-warnings 0 && prettier --check .",
    "format": "prettier --write . && eslint . --fix",
    "test": "vitest run",
    "cdk": "pnpm --filter @nina-pm/infra exec cdk",
    "deploy:prod": "tsx tools/deploy/src/deploy-prod.ts",
    "test:dsql": "tsx tools/deploy/src/test-dsql.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.6",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.1"
  }
}
