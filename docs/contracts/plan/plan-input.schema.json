{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/PlanInput",
  "$defs": {
    "PlanInput": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "productive",
            "compat"
          ]
        },
        "night": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "example": "2026-09-18"
        },
        "site": {
          "type": "object",
          "properties": {
            "latitudeDeg": {
              "type": "number",
              "minimum": -89.9,
              "maximum": 89.9
            },
            "longitudeDeg": {
              "type": "number",
              "minimum": -180,
              "maximum": 180
            },
            "elevationM": {
              "type": "number"
            }
          },
          "required": [
            "latitudeDeg",
            "longitudeDeg",
            "elevationM"
          ],
          "additionalProperties": false
        },
        "tzdataVersion": {
          "type": "string"
        },
        "timeZoneTransitions": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "atUtc": {
                "type": "string",
                "format": "date-time",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                "example": "2026-09-18T13:00:00Z"
              },
              "utcOffsetMinutes": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "atUtc",
              "utcOffsetMinutes"
            ],
            "additionalProperties": false
          }
        },
        "rig": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "hasRotator": {
              "type": "boolean"
            },
            "defaultRotationDeg": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": 0,
                  "exclusiveMaximum": 360
                },
                {
                  "type": "null"
                }
              ]
            },
            "rotationToleranceDeg": {
              "type": "number",
              "minimum": 0,
              "maximum": 90
            },
            "hasFilterWheel": {
              "type": "boolean"
            }
          },
          "required": [
            "id",
            "hasRotator",
            "defaultRotationDeg",
            "rotationToleranceDeg",
            "hasFilterWheel"
          ],
          "additionalProperties": false
        },
        "scheduler": {
          "type": "object",
          "properties": {
            "strategy": {
              "type": "string",
              "enum": [
                "proportional",
                "manual_priority"
              ]
            },
            "sortChain": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "lowest_peak_altitude",
                  "setting_soonest",
                  "most_remaining",
                  "constrained",
                  "most_moon_limited",
                  "mosaic_grouping",
                  "card_order",
                  "due_soonest"
                ]
              }
            },
            "bonusEnabled": {
              "type": "boolean"
            },
            "overshootPct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "mosaicPanelsIndependent": {
              "type": "boolean"
            },
            "ditherEnabled": {
              "type": "boolean"
            },
            "ditherEvery": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "filterSwitchEnabled": {
              "type": "boolean"
            },
            "filterSwitchEvery": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "filterSwitchTolerancePct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "flatsSource": {
              "type": "string",
              "enum": [
                "panel",
                "sky"
              ]
            },
            "flip": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "afterMin": {
                  "type": "number",
                  "minimum": 0
                },
                "maxAfterMin": {
                  "type": "number",
                  "minimum": 0
                },
                "pauseBeforeMin": {
                  "type": "number",
                  "minimum": 0
                },
                "durationS": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "enabled",
                "afterMin",
                "maxAfterMin",
                "pauseBeforeMin",
                "durationS"
              ],
              "additionalProperties": false
            },
            "overhead": {
              "type": "object",
              "properties": {
                "slewCenterS": {
                  "type": "number",
                  "minimum": 0
                },
                "filterChangeS": {
                  "type": "number",
                  "minimum": 0
                },
                "ditherSettleS": {
                  "type": "number",
                  "minimum": 0
                },
                "afEveryMin": {
                  "type": "number",
                  "minimum": 0
                },
                "afDurationS": {
                  "type": "number",
                  "minimum": 0
                },
                "downloadS": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "slewCenterS",
                "filterChangeS",
                "ditherSettleS",
                "afEveryMin",
                "afDurationS",
                "downloadS"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "strategy",
            "sortChain",
            "bonusEnabled",
            "overshootPct",
            "mosaicPanelsIndependent",
            "ditherEnabled",
            "ditherEvery",
            "filterSwitchEnabled",
            "filterSwitchEvery",
            "filterSwitchTolerancePct",
            "flatsSource",
            "flip",
            "overhead"
          ],
          "additionalProperties": false
        },
        "moonProfiles": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "separationDeg": {
                "type": "number",
                "minimum": 0,
                "maximum": 180
              },
              "widthDays": {
                "type": "number",
                "minimum": 0
              },
              "relaxScale": {
                "type": "number",
                "minimum": 0
              },
              "moonMinAltDeg": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "moonMaxAltDeg": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "maxIlluminationPct": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              },
              "moonMustBeDown": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "separationDeg",
              "widthDays",
              "relaxScale",
              "moonMinAltDeg",
              "moonMaxAltDeg",
              "maxIlluminationPct",
              "moonMustBeDown"
            ],
            "additionalProperties": false
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "raDeg": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 360
              },
              "decDeg": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "rotationDeg": {
                "type": "number",
                "minimum": 0,
                "exclusiveMaximum": 360
              },
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "minAltitudeDeg": {
                "type": "number",
                "minimum": -90,
                "maximum": 90
              },
              "minTimeOnTargetH": {
                "type": "number",
                "minimum": 0,
                "maximum": 24
              },
              "twilight": {
                "type": "string",
                "enum": [
                  "astronomical",
                  "nautical",
                  "civil"
                ]
              },
              "startDate": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                    "example": "2026-09-18"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "dueDate": {
                "anyOf": [
                  {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
                    "example": "2026-09-18"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "panels": {
                "minItems": 1,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "index": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    },
                    "raDeg": {
                      "type": "number",
                      "minimum": 0,
                      "exclusiveMaximum": 360
                    },
                    "decDeg": {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    },
                    "rotationDeg": {
                      "type": "number",
                      "minimum": 0,
                      "exclusiveMaximum": 360
                    },
                    "lines": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 80
                          },
                          "filter": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 40
                          },
                          "ninaFilterName": {
                            "anyOf": [
                              {
                                "type": "string",
                                "maxLength": 60
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "exposureS": {
                            "type": "number",
                            "exclusiveMinimum": 0
                          },
                          "planned": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "accepted": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "pending": {
                            "type": "integer",
                            "minimum": 0,
                            "maximum": 9007199254740991
                          },
                          "enabled": {
                            "type": "boolean"
                          },
                          "moonProfileId": {
                            "anyOf": [
                              {
                                "type": "string",
                                "minLength": 1,
                                "maxLength": 80
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "gain": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "offset": {
                            "anyOf": [
                              {
                                "type": "integer",
                                "minimum": -9007199254740991,
                                "maximum": 9007199254740991
                              },
                              {
                                "type": "null"
                              }
                            ]
                          },
                          "binning": {
                            "type": "integer",
                            "minimum": 1,
                            "maximum": 9007199254740991
                          },
                          "readoutMode": {
                            "type": [
                              "string",
                              "null"
                            ]
                          }
                        },
                        "required": [
                          "id",
                          "filter",
                          "ninaFilterName",
                          "exposureS",
                          "planned",
                          "accepted",
                          "pending",
                          "enabled",
                          "moonProfileId",
                          "gain",
                          "offset",
                          "binning",
                          "readoutMode"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "id",
                    "index",
                    "raDeg",
                    "decDeg",
                    "rotationDeg",
                    "lines"
                  ],
                  "additionalProperties": false
                }
              },
              "transit": {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "observationId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "lineId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "windowStartUtc": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                        "example": "2026-09-18T13:00:00Z"
                      },
                      "windowEndUtc": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                        "example": "2026-09-18T13:00:00Z"
                      },
                      "lockedAtUtc": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                        "example": "2026-09-18T13:00:00Z"
                      }
                    },
                    "required": [
                      "observationId",
                      "lineId",
                      "windowStartUtc",
                      "windowEndUtc",
                      "lockedAtUtc"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "raDeg",
              "decDeg",
              "rotationDeg",
              "priority",
              "minAltitudeDeg",
              "minTimeOnTargetH",
              "twilight",
              "startDate",
              "dueDate",
              "panels",
              "transit"
            ],
            "additionalProperties": false
          }
        },
        "startAtUtc": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "example": "2026-09-18T13:00:00Z"
            },
            {
              "type": "null"
            }
          ]
        },
        "tonight": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "pastBlocks": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "unitId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "fromUtc": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                        "example": "2026-09-18T13:00:00Z"
                      },
                      "toUtc": {
                        "type": "string",
                        "format": "date-time",
                        "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                        "example": "2026-09-18T13:00:00Z"
                      }
                    },
                    "required": [
                      "unitId",
                      "fromUtc",
                      "toUtc"
                    ],
                    "additionalProperties": false
                  }
                },
                "exposedSecByUnit": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "lastAutofocusUtc": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
                      "example": "2026-09-18T13:00:00Z"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "filterCycle": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "unitId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "lineId": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 80
                      },
                      "subsOnLine": {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 9007199254740991
                      }
                    },
                    "required": [
                      "unitId",
                      "lineId",
                      "subsOnLine"
                    ],
                    "additionalProperties": false
                  }
                },
                "flipDoneByPanel": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "boolean"
                  }
                },
                "currentUnitId": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "pastBlocks",
                "exposedSecByUnit",
                "lastAutofocusUtc",
                "filterCycle",
                "flipDoneByPanel",
                "currentUnitId"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "mode",
        "night",
        "site",
        "tzdataVersion",
        "timeZoneTransitions",
        "rig",
        "scheduler",
        "moonProfiles",
        "projects",
        "startAtUtc",
        "tonight"
      ],
      "additionalProperties": false
    }
  },
  "title": "Svenesis NINA-PM – PlanInput (TK 8.2)"
}
