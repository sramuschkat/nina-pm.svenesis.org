{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/NinaHeartbeat",
  "$defs": {
    "NinaHeartbeat": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "running",
            "idle",
            "paused",
            "flats",
            "offline",
            "blocked"
          ]
        },
        "blockedReason": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "lease_lost",
                "rig_busy",
                "token_invalid",
                "clock_skew",
                "plan_failed",
                "engine_incompatible",
                "tenant_locked"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "sessionId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "UUID"
            },
            {
              "type": "null"
            }
          ]
        },
        "blockId": {
          "anyOf": [
            {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "UUID"
            },
            {
              "type": "null"
            }
          ]
        },
        "pluginVersion": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "engineVersion": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "profileLocation": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "latDeg": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "lonDeg": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                }
              },
              "required": [
                "latDeg",
                "lonDeg"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "cameraReadoutModes": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "index": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "name": {
                "type": "string",
                "maxLength": 256
              }
            },
            "required": [
              "index",
              "name"
            ]
          }
        },
        "meridianFlip": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "triggerPresent": {
                  "type": [
                    "boolean",
                    "null"
                  ]
                },
                "useSideOfPier": {
                  "type": "boolean"
                },
                "recenter": {
                  "type": "boolean"
                },
                "autoFocusAfterFlip": {
                  "type": "boolean"
                },
                "settleTimeS": {
                  "type": "number",
                  "minimum": 0
                },
                "pauseBeforeMin": {
                  "type": "number",
                  "minimum": 0
                },
                "afterMin": {
                  "type": "number",
                  "minimum": 0
                },
                "maxAfterMin": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "useSideOfPier",
                "recenter",
                "autoFocusAfterFlip",
                "settleTimeS",
                "pauseBeforeMin",
                "afterMin",
                "maxAfterMin"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "rotator": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "connected": {
                  "type": "boolean"
                },
                "rangeType": {
                  "type": "string",
                  "enum": [
                    "FULL",
                    "HALF",
                    "QUARTER"
                  ]
                },
                "rangeStartMechanicalDeg": {
                  "type": "number",
                  "minimum": -360,
                  "maximum": 360
                },
                "reverse": {
                  "type": "boolean"
                }
              },
              "required": [
                "connected",
                "rangeType",
                "rangeStartMechanicalDeg",
                "reverse"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "plateSolve": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "rotationToleranceDeg": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "required": [
                "rotationToleranceDeg"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "mount": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "equatorialSystem": {
                  "type": "string",
                  "enum": [
                    "J2000",
                    "JNOW",
                    "B1950",
                    "J2050"
                  ]
                },
                "siteLatDeg": {
                  "type": "number",
                  "minimum": -90,
                  "maximum": 90
                },
                "siteLonDeg": {
                  "type": "number",
                  "minimum": -180,
                  "maximum": 180
                },
                "siderealTimeDeltaS": {
                  "type": "number"
                }
              },
              "required": [
                "equatorialSystem",
                "siteLatDeg",
                "siteLonDeg",
                "siderealTimeDeltaS"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "sequenceTriggers": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "autofocus": {
                  "maxItems": 32,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 256
                  }
                },
                "autofocusAfterTimeMin": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "dither": {
                  "maxItems": 32,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "maxLength": 256
                  }
                }
              },
              "required": [
                "autofocus",
                "autofocusAfterTimeMin",
                "dither"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "camera": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "temperatureC": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "setPointC": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "coolerOn": {
                  "type": "boolean"
                },
                "coolerPowerPct": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 100
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "temperatureC",
                "setPointC",
                "coolerOn",
                "coolerPowerPct"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "lastMeasuredRotationDeg": {
          "anyOf": [
            {
              "type": "number",
              "minimum": -360,
              "maximum": 360
            },
            {
              "type": "null"
            }
          ]
        },
        "devices": {
          "anyOf": [
            {
              "$ref": "#/$defs/NinaDevices"
            },
            {
              "type": "null"
            }
          ]
        },
        "optics": {
          "anyOf": [
            {
              "$ref": "#/$defs/NinaOptics"
            },
            {
              "type": "null"
            }
          ]
        },
        "filterWheel": {
          "anyOf": [
            {
              "maxItems": 64,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "position": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 9007199254740991
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 256
                  },
                  "focusOffset": {
                    "type": "number"
                  }
                },
                "required": [
                  "position",
                  "name",
                  "focusOffset"
                ]
              }
            },
            {
              "type": "null"
            }
          ]
        },
        "outboxPending": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deadLetters": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "settingsVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "offlineUntil": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
              "example": "2026-09-18T13:00:00Z"
            },
            {
              "type": "null"
            }
          ]
        },
        "ackedCommandIds": {
          "maxItems": 100,
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
            "description": "UUID"
          }
        }
      },
      "required": [
        "state",
        "pluginVersion",
        "engineVersion"
      ]
    },
    "NinaDevices": {
      "type": "object",
      "properties": {
        "connected": {
          "type": "object",
          "properties": {
            "camera": {
              "type": "boolean"
            },
            "mount": {
              "type": "boolean"
            },
            "focuser": {
              "type": "boolean"
            },
            "filterWheel": {
              "type": "boolean"
            },
            "rotator": {
              "type": "boolean"
            },
            "guider": {
              "type": "boolean"
            },
            "safetyMonitor": {
              "type": "boolean"
            },
            "weather": {
              "type": "boolean"
            },
            "flatDevice": {
              "type": "boolean"
            },
            "switch": {
              "type": "boolean"
            },
            "dome": {
              "type": "boolean"
            }
          },
          "required": [
            "camera",
            "mount",
            "focuser",
            "filterWheel",
            "rotator",
            "guider",
            "safetyMonitor",
            "weather",
            "flatDevice",
            "switch",
            "dome"
          ]
        },
        "focuser": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "position": {
                  "type": "number"
                },
                "temperatureC": {
                  "type": [
                    "number",
                    "null"
                  ]
                },
                "moving": {
                  "type": "boolean"
                }
              },
              "required": [
                "position",
                "temperatureC",
                "moving"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "mountState": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "pierSide": {
                  "anyOf": [
                    {
                      "type": "string",
                      "enum": [
                        "east",
                        "west"
                      ]
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "tracking": {
                  "type": "boolean"
                },
                "atPark": {
                  "type": "boolean"
                },
                "slewing": {
                  "type": "boolean"
                },
                "altitudeDeg": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": -90,
                      "maximum": 90
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "azimuthDeg": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 360
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "pierSide",
                "tracking",
                "atPark",
                "slewing",
                "altitudeDeg",
                "azimuthDeg"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "guider": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "rmsTotalArcsec": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "rmsRaArcsec": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "rmsDecArcsec": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "rmsTotalArcsec",
                "rmsRaArcsec",
                "rmsDecArcsec"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "filter": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "safe": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "weather": {
          "anyOf": [
            {
              "$ref": "#/$defs/NinaWeatherNow"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "connected",
        "focuser",
        "mountState",
        "guider",
        "filter",
        "safe",
        "weather"
      ]
    },
    "NinaWeatherNow": {
      "type": "object",
      "properties": {
        "cloudCoverPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "skyQualityMag": {
          "type": "number"
        },
        "skyBrightnessLux": {
          "type": "number",
          "minimum": 0
        },
        "skyTemperatureC": {
          "type": "number"
        },
        "starFwhmArcsec": {
          "type": "number",
          "minimum": 0
        },
        "temperatureC": {
          "type": "number"
        },
        "humidityPct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "dewPointC": {
          "type": "number"
        },
        "pressureHpa": {
          "type": "number",
          "minimum": 0
        },
        "windSpeedMs": {
          "type": "number",
          "minimum": 0
        },
        "windGustMs": {
          "type": "number",
          "minimum": 0
        },
        "windDirectionDeg": {
          "type": "number",
          "minimum": 0,
          "maximum": 360
        },
        "rainRateMmH": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "NinaOptics": {
      "type": "object",
      "properties": {
        "focalLengthMm": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "focalRatio": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "pixelSizeUm": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "sensorWidthPx": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "sensorHeightPx": {
          "anyOf": [
            {
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "cameraName": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "telescopeName": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        },
        "ninaVersion": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 256
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "focalLengthMm",
        "focalRatio",
        "pixelSizeUm",
        "sensorWidthPx",
        "sensorHeightPx",
        "cameraName",
        "telescopeName",
        "ninaVersion"
      ]
    }
  },
  "title": "Svenesis NINA-PM – NINA-API POST /heartbeat (TK 7.6)"
}
