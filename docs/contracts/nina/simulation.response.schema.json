          "example": "2026-09-18T13:00:00Z"
        },
        "utcOffsetMinutes": {
          "type": "integer",
          "minimum": -9007199254740991,
          "maximum": 9007199254740991
        },
        "abbr": {
          "type": "string",
          "maxLength": 256
        }
