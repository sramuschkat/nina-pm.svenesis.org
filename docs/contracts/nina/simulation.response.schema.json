{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$ref": "#/$defs/NinaSimulation",
  "$defs": {
    "NinaSimulation": {
      "type": "object",
      "properties": {
        "night": {
          "type": "string",
          "format": "date",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$",
          "example": "2026-09-18"
        },
        "generatedAtUtc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$",
          "example": "2026-09-18T13:00:00Z"
        },
        "engineVersion": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^\\d+\\.\\d+\\.\\d+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "inputHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{1,64}$"
        },
        "outputHash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{1,64}$"
        },
        "settingsVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "timeZone": {
          "type": "string",
          "maxLength": 256
        },
        "timeZoneSegments": {
          "minItems": 1,
          "maxItems": 10,
          "type": "array",
          "items": {
            "$ref": "#/$defs/NinaSimulationTimeZoneSegment"
          }
        },
        "nightWindow": {
          "$ref": "#/$defs/NinaSimulationNightWindow"
        },
        "darkness": {
          "$ref": "#/$defs/NinaSimulationDarkness"
        },
        "header": {
          "$ref": "#/$defs/NinaSimulationHeader"
        },
        "targets": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "$ref": "#/$defs/NinaSimulationTarget"
          }
        },
        "moon": {
          "$ref": "#/$defs/NinaSimulationMoon"
        },
        "blocks": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "$ref": "#/$defs/NinaSimulationBlock"
          }
        },
        "filterBars": {
          "maxItems": 5000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/NinaSimulationFilterBar"
          }
        },
        "flips": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "$ref": "#/$defs/NinaSimulationFlip"
          }
        },
        "cards": {
          "maxItems": 200,
          "type": "array",
          "items": {
            "$ref": "#/$defs/NinaSimulationCard"
          }
        },
        "unallocated": {
          "maxItems": 500,
          "type": "array",
          "items": {
            "$ref": "#/$defs/NinaSimulationUnallocated"
          }
        },
        "protocol": {
          "maxItems": 50000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/NinaSimulationProtocolRow"
          }
        },
        "warnings": {
          "maxItems": 1000,
          "type": "array",
          "items": {
            "$ref": "#/$defs/NinaSimulationWarning"
          }
        },
        "executed": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExecutedNight"
            },
            {
              "type": "null"
            }
          ]
        },
        "storedPlan": {
          "anyOf": [
            {
              "$ref": "#/$defs/StoredPlanInfo"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "night",
        "generatedAtUtc",
        "engineVersion",
        "inputHash",
        "settingsVersion",
        "timeZone",
        "timeZoneSegments",
        "nightWindow",
        "darkness",
        "header",
        "targets",
        "moon",
        "blocks",
        "filterBars",
        "flips",
        "cards",
        "unallocated",
        "protocol",
        "warnings"
      ]
    },
