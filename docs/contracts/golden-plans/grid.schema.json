                "type": "string",
                "pattern": "^[^/]+(\\/p(0|[1-9][0-9]*))?$"
              },
              "projectId": {
                "type": "string",
                "pattern": "^[^/]+$"
              },
              "priority": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
