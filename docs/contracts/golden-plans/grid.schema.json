            "filterSwitch": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "every": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "tolerancePct": {
                  "type": "number",
                  "minimum": 0,
                  "maximum": 100
                }
              },
              "required": [
                "enabled",
                "every",
                "tolerancePct"
              ],
              "additionalProperties": false
