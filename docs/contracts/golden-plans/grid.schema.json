{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^G[0-9]{2,3}[a-z]?$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "explanation": {
      "type": "string"
    },
    "approvedBy": {
      "type": [
        "string",
        "null"
      ]
    },
    "oracleDiff": {
      "type": [
        "string",
        "null"
      ]
    },
    "input": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "productive",
            "compat"
          ]
        },
        "slotS": {
          "type": "number",
          "const": 300
        },
        "slots": {
          "type": "integer",
          "minimum": 1,
          "maximum": 288
        },
        "startAtS": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            {
              "type": "null"
            }
          ]
        },
        "moonAltDeg": {
          "type": "array",
          "items": {
            "type": "number",
            "minimum": -90,
            "maximum": 90
          }
        },
        "settings": {
          "type": "object",
          "properties": {
            "strategy": {
              "type": "string",
              "enum": [
                "proportional",
                "manual_priority"
              ]
            },
            "sortChain": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "lowest_peak_altitude",
                  "setting_soonest",
                  "most_remaining",
                  "constrained",
                  "most_moon_limited",
                  "mosaic_grouping",
                  "card_order",
                  "due_soonest"
                ]
              }
            },
            "bonusEnabled": {
              "type": "boolean"
            },
            "overshootPct": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "mosaicPanelsIndependent": {
              "type": "boolean"
            },
            "dither": {
              "type": "object",
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "every": {
                  "type": "integer",
