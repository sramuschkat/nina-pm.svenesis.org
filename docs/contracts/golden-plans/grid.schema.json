                "filterChangeS": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "ditherSettleS": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "afEveryMin": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "afDurationS": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "downloadS": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
