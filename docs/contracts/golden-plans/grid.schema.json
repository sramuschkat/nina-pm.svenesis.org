                        "properties": {
                          "id": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 64
                          },
                          "filter": {
                            "type": "string",
                            "minLength": 1,
                            "maxLength": 32
                          },
                          "exposureS": {
                            "type": "integer",
                            "exclusiveMinimum": 0,
                            "maximum": 9007199254740991
