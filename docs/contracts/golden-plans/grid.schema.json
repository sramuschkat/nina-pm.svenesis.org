                "maxAfterMin": {
                  "type": "number",
                  "minimum": 0
                },
                "pauseBeforeMin": {
                  "type": "number",
                  "minimum": 0
                },
                "durationS": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "enabled",
                "afterMin",
                "maxAfterMin",
                "pauseBeforeMin",
                "durationS"
